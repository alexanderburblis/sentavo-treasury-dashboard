table _Measures
	lineageTag: 03609879-3eec-4921-9f90-d5d0041cd02e

	measure 'Cash CHF' = VAR _AsOf = MAX ( FactLiquidityPosition[Date] ) RETURN CALCULATE ( SUM ( FactLiquidityPosition[Balance_CHF] ), FactLiquidityPosition[Date] = _AsOf )
		formatString: #,0.0
