	measure 'Fcst Net 13W CHF' = CALCULATE ( SUM ( FactCashForecast[Forecast_CHF] ), FactCashForecast[FlowCategory] <> "Intercompany", FactCashForecast[HorizonWeeks] = 13 )
		formatString: #,0.0
		displayFolder: 3 Forecast
		lineageTag: 0ec22791-6c0c-4ed7-89e0-cadf4d0e5d24

	measure 'Fcst Net 1W CHF' = CALCULATE ( SUM ( FactCashForecast[Forecast_CHF] ), FactCashForecast[FlowCategory] <> "Intercompany", FactCashForecast[HorizonWeeks] = 1 )
		formatString: #,0.0
		displayFolder: 3 Forecast
		lineageTag: 6fcca457-0138-4010-9900-2e32abe6cbc5

	measure 'Actual Net CHF' = CALCULATE ( SUM ( FactCashForecast[Actual_CHF] ), FactCashForecast[FlowCategory] <> "Intercompany", FactCashForecast[HorizonWeeks] = 1 )
		formatString: #,0.0
		displayFolder: 3 Forecast
		lineageTag: bf1413df-8675-4980-8d42-95a70e2fba42

	measure 'Last13W Flag' = VAR _Last = CALCULATE ( MAX ( FactCashForecast[WeekStart] ), REMOVEFILTERS () ) VAR _Cur = MAX ( 'Date'[WeekStart] ) RETURN IF ( _Cur > _Last - 91 && _Cur <= _Last, 1, 0 )
		formatString: 0
		displayFolder: 3 Forecast
		lineageTag: 3c451180-4bb4-417b-b190-a61dc23bb589

	/// Running total over the last 13 forecast weeks. The current week is capped at
	/// the last forecast week, so a card with no date filter shows the full window.
	measure 'Cum Fcst 13W CHF' =
			VAR _Last  = CALCULATE ( MAX ( FactCashForecast[WeekStart] ), REMOVEFILTERS () )
			VAR _Start = _Last - 84
			VAR _Max   = MAX ( 'Date'[WeekStart] )
			VAR _Cur   = MIN ( _Max, _Last )
			RETURN
			    IF (
			        _Cur >= _Start && NOT ( HASONEVALUE ( 'Date'[WeekStart] ) && _Max > _Last ),
			        CALCULATE (
			            [Fcst Net 13W CHF],
			            REMOVEFILTERS ( 'Date' ),
			            'Date'[WeekStart] >= _Start,
			            'Date'[WeekStart] <= _Cur
			        )
			    )
		formatString: #,0.0
		displayFolder: 3 Forecast
		lineageTag: 4eb39ba7-7af2-49b9-b330-3ccdb6c41dff

	/// Running total over the last 13 forecast weeks. The current week is capped at
	/// the last forecast week, so a card with no date filter shows the full window.
	measure 'Cum Fcst 1W CHF' =
			VAR _Last  = CALCULATE ( MAX ( FactCashForecast[WeekStart] ), REMOVEFILTERS () )
			VAR _Start = _Last - 84
			VAR _Max   = MAX ( 'Date'[WeekStart] )
			VAR _Cur   = MIN ( _Max, _Last )
			RETURN
			    IF (
			        _Cur >= _Start && NOT ( HASONEVALUE ( 'Date'[WeekStart] ) && _Max > _Last ),
			        CALCULATE (
			            [Fcst Net 1W CHF],
			            REMOVEFILTERS ( 'Date' ),
			            'Date'[WeekStart] >= _Start,
			            'Date'[WeekStart] <= _Cur
			        )
			    )
		formatString: #,0.0
		displayFolder: 3 Forecast
		lineageTag: 51130ea5-a285-488e-9d67-ac834b144353

	/// Running total over the last 13 forecast weeks. The current week is capped at
	/// the last forecast week, so a card with no date filter shows the full window.
	measure 'Cum Actual CHF' =
			VAR _Last  = CALCULATE ( MAX ( FactCashForecast[WeekStart] ), REMOVEFILTERS () )
			VAR _Start = _Last - 84
			VAR _Max   = MAX ( 'Date'[WeekStart] )
			VAR _Cur   = MIN ( _Max, _Last )
			RETURN
			    IF (
			        _Cur >= _Start && NOT ( HASONEVALUE ( 'Date'[WeekStart] ) && _Max > _Last ),
			        CALCULATE (
			            [Actual Net CHF],
			            REMOVEFILTERS ( 'Date' ),
			            'Date'[WeekStart] >= _Start,
			            'Date'[WeekStart] <= _Cur
			        )
			    )
		formatString: #,0.0
		displayFolder: 3 Forecast
		lineageTag: 8f6776ea-9524-45dd-9d38-3cfa9d6d29d7

	measure 'Cum Gap 13W CHF' = [Cum Fcst 13W CHF] - [Cum Actual CHF]
		formatString: +#,0.0;-#,0.0;
		displayFolder: 3 Forecast
		lineageTag: 036d13c2-4dd2-4940-bd23-cfdf3a5cb216

	measure 'Abs Fcst Error CHF' = SUMX ( FactCashForecast, ABS ( FactCashForecast[Forecast_CHF] - FactCashForecast[Actual_CHF] ) )
		formatString: #,0.0
		displayFolder: 3 Forecast
		lineageTag: 31f3d666-5c0e-44f8-b7d1-5178d9e3b54a

	measure 'Abs Actual CHF' = CALCULATE ( SUMX ( FactCashForecast, ABS ( FactCashForecast[Actual_CHF] ) ), FactCashForecast[HorizonWeeks] = 1 )
		formatString: #,0.0
		displayFolder: 3 Forecast
		lineageTag: 63203d2e-49e8-4c4f-b02f-2dccc01b901b

	measure 'Forecast WAPE %' = DIVIDE ( [Abs Fcst Error CHF], [Abs Actual CHF] )
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: 3 Forecast
		lineageTag: 7840ce1e-ad7b-4592-bd18-f061d954eb05

	measure 'Receipts Bias %' = VAR _F = CALCULATE ( SUM ( FactCashForecast[Forecast_CHF] ), FactCashForecast[FlowCategory] = "Customer receipts" ) VAR _A = CALCULATE ( SUM ( FactCashForecast[Actual_CHF] ), FactCashForecast[FlowCategory] = "Customer receipts", FactCashForecast[HorizonWeeks] = 1 ) RETURN DIVIDE ( _F - _A, _A )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 3 Forecast
		lineageTag: 107ccb2f-5f5c-4057-a5ee-4412d398ca01

	/// Last month with booked actuals.
	measure 'Last Actual Month' = CALCULATE ( MAX ( FactTreasuryPnL[Month] ), DimScenario[Scenario] = "Actual", REMOVEFILTERS () )
		formatString: mmm yyyy
		displayFolder: 4 Budget vs actual
		lineageTag: 80ba67f2-1a39-4707-9259-894c5159c7e2

	/// Name of the most recent reforecast.
	measure 'Latest Forecast' = CALCULATE ( MAX ( DimScenario[Scenario] ), DimScenario[ScenarioType] = "Reforecast", REMOVEFILTERS () )
		displayFolder: 4 Budget vs actual
		lineageTag: 348043d4-984a-4047-99a0-fd36126d3e15

	/// Base measure for the Scenario View calculation group. Blank unless one
	/// scenario is in context, so actuals and plans are never added together.
	measure 'PnL Amount CHF' = IF ( HASONEVALUE ( DimScenario[Scenario] ), SUM ( FactTreasuryPnL[Amount_CHF] ) )
		formatString: #,0
		displayFolder: 4 Budget vs actual
		lineageTag: 7e258bcb-9cb3-4728-bf34-e031b5c16e66

	measure 'PnL Amount YTD CHF' =
			VAR _End = [YTD End Date]
			RETURN CALCULATE ( [PnL Amount CHF], DATESBETWEEN ( 'Date'[Date], DATE ( YEAR ( _End ), 1, 1 ), _End ) )
		formatString: #,0
		displayFolder: 4 Budget vs actual
		lineageTag: 7b1b5adc-4fcd-4bcd-9e09-f11384f488df

	measure 'Actual CHF' = CALCULATE ( SUM ( FactTreasuryPnL[Amount_CHF] ), DimScenario[Scenario] = "Actual" )
		formatString: #,0
		displayFolder: 4 Budget vs actual
		lineageTag: b65d5c5c-5cf2-4399-a0d9-bfa462963f94

	measure 'Budget CHF' = CALCULATE ( SUM ( FactTreasuryPnL[Amount_CHF] ), DimScenario[Scenario] = "Budget" )
		formatString: #,0
		displayFolder: 4 Budget vs actual
		lineageTag: fe9f7940-7770-4592-90a9-e90def8d8a8e

	measure 'Forecast CHF' =
			VAR _Latest = [Latest Forecast]
			RETURN CALCULATE ( SUM ( FactTreasuryPnL[Amount_CHF] ), DimScenario[Scenario] = _Latest )
		formatString: #,0
		displayFolder: 4 Budget vs actual
		lineageTag: 24b91a7e-ca37-4f29-8bbd-e4515aad7cff

	/// Closed months only, so open months do not show the full budget as a variance.
	measure 'Variance CHF' =
			VAR _A = [Actual CHF]
			VAR _B = CALCULATE ( [Budget CHF], KEEPFILTERS ( 'Date'[IsClosedMonth] = 1 ) )
			RETURN IF ( NOT ISBLANK ( _A ), _A - _B )
		formatString: +#,0;-#,0;0
		displayFolder: 4 Budget vs actual
		lineageTag: 50b49cd8-aaf4-42c5-a13e-382871beefd6

	/// Positive = favourable (income above budget or cost below budget).
	measure 'Variance %' = DIVIDE ( [Variance CHF], ABS ( CALCULATE ( [Budget CHF], KEEPFILTERS ( 'Date'[IsClosedMonth] = 1 ) ) ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 4 Budget vs actual
		lineageTag: fbcbd308-d0d5-4175-9b72-7abe5dc8b136

	measure 'Actual YTD CHF' =
			VAR _End = [YTD End Date]
			RETURN CALCULATE ( [Actual CHF], DATESBETWEEN ( 'Date'[Date], DATE ( YEAR ( _End ), 1, 1 ), _End ) )
		formatString: #,0.00
		displayFolder: 4 Budget vs actual\Year to date
		lineageTag: 80ec895a-936a-45ab-820b-25be8a70f012

	/// Budget for the same closed months as the actuals.
	measure 'Budget YTD CHF' =
			VAR _End = [YTD End Date]
			RETURN CALCULATE ( [Budget CHF], DATESBETWEEN ( 'Date'[Date], DATE ( YEAR ( _End ), 1, 1 ), _End ) )
		formatString: #,0.00
		displayFolder: 4 Budget vs actual\Year to date
		lineageTag: a87f343b-79bf-40aa-8d32-e137581f6699

	measure 'Variance YTD CHF' = [Actual YTD CHF] - [Budget YTD CHF]
		formatString: +#,0.00;-#,0.00;0.00
		displayFolder: 4 Budget vs actual\Year to date
		lineageTag: 7c53b13d-964d-4841-a0a5-449b4f46329e

	measure 'Variance YTD %' = DIVIDE ( [Variance YTD CHF], ABS ( [Budget YTD CHF] ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 4 Budget vs actual\Year to date
		lineageTag: 5f66960d-04b5-4395-ba8b-d15d229a4a52

	measure 'Actual PY CHF' = CALCULATE ( [Actual CHF], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
		formatString: #,0
		displayFolder: 4 Budget vs actual\Year to date
		lineageTag: 286dee45-b4ff-409f-8f6a-e2301866ea02

	measure 'Actual YoY %' = DIVIDE ( [Actual CHF] - [Actual PY CHF], ABS ( [Actual PY CHF] ) )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 4 Budget vs actual\Year to date
		lineageTag: c4419930-7f66-43b6-ae20-4788270f04db

	measure 'Actual Rolling 3M CHF' = CALCULATE ( [Actual CHF], DATESINPERIOD ( 'Date'[Date], MAX ( 'Date'[Date] ), -3, MONTH ) )
		formatString: #,0
		displayFolder: 4 Budget vs actual\Year to date
		lineageTag: fb45d023-2d88-45b1-a605-622b3fcd229d

	measure 'Budget FY CHF' =
			VAR _Year = YEAR ( [YTD End Date] )
			RETURN CALCULATE ( [Budget CHF], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = _Year )
		formatString: #,0.00
		displayFolder: 4 Budget vs actual\Full year
		lineageTag: 75c6675d-2fda-481e-a653-cae3510d92a7

	/// Actuals for closed months plus the latest forecast for the rest of the year.
	measure 'Outturn FY CHF' =
			VAR _Year = YEAR ( [YTD End Date] )
			VAR _Latest = [Latest Forecast]
			VAR _Booked = CALCULATE ( [Actual CHF], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = _Year, 'Date'[IsClosedMonth] = 1 )
			VAR _ToCome = CALCULATE ( SUM ( FactTreasuryPnL[Amount_CHF] ), DimScenario[Scenario] = _Latest, REMOVEFILTERS ( 'Date' ), 'Date'[Year] = _Year, 'Date'[IsClosedMonth] = 0 )
			RETURN _Booked + _ToCome
		formatString: #,0.00
		displayFolder: 4 Budget vs actual\Full year
		lineageTag: 188018c0-77f8-4702-91b1-bd42d23ff821

	measure 'Outturn vs Budget CHF' = [Outturn FY CHF] - [Budget FY CHF]
		formatString: +#,0.00;-#,0.00;0.00
		displayFolder: 4 Budget vs actual\Full year
		lineageTag: f41bc56a-6f63-4038-af8c-a300239e2799

	/// Text for the variance commentary box. Follows the year selected on the page.
	measure 'Variance Commentary' =
			VAR _Last = [Last Actual Month]
			VAR _End = MIN ( MAX ( 'Date'[Date] ), EOMONTH ( _Last, 0 ) )
			VAR _A = [Actual YTD CHF]
			VAR _B = [Budget YTD CHF]
			VAR _V = _A - _B
			VAR _Lines =
			    ADDCOLUMNS (
			        CALCULATETABLE ( VALUES ( FactTreasuryPnL[Line] ), REMOVEFILTERS ( FactTreasuryPnL[Line] ) ),
			        "@Var", CALCULATE ( [Variance YTD CHF] )
			    )
			VAR _Top = TOPN ( 1, _Lines, ABS ( [@Var] ), DESC )
			VAR _TopLine = MAXX ( _Top, FactTreasuryPnL[Line] )
			VAR _TopVar = MAXX ( _Top, [@Var] )
			VAR _Banks =
			    ADDCOLUMNS (
			        VALUES ( DimBank[BankLabel] ),
			        "@FeeVar", CALCULATE ( [Variance YTD CHF], FactTreasuryPnL[Line] = "Bank fees" )
			    )
			VAR _WorstBank = TOPN ( 1, _Banks, [@FeeVar], ASC )
			VAR _BankName = MAXX ( _WorstBank, DimBank[BankLabel] )
			VAR _BankVar = MAXX ( _WorstBank, [@FeeVar] )
			RETURN
			    "Jan to " & FORMAT ( _End, "mmm yyyy" ) & ": treasury result "
			        & "CHF " & FORMAT ( _A / 1e6, "0.00" ) & "m against a budget of CHF " & FORMAT ( _B / 1e6, "0.00" ) & "m, "
			        & IF ( _V >= 0, "favourable", "unfavourable" ) & " by CHF " & FORMAT ( ABS ( _V ) / 1e6, "0.00" ) & "m ("
			        & FORMAT ( DIVIDE ( _V, ABS ( _B ) ), "+0.0%;-0.0%" ) & "). "
			        & "The largest driver is " & LOWER ( _TopLine ) & " at CHF "
			        & FORMAT ( _TopVar / 1e6, "+0.00;-0.00" ) & "m. "
			        & IF (
			            _BankVar < 0,
			            "In bank fees, " & _BankName & " is CHF " & FORMAT ( ABS ( _BankVar ) / 1e3, "0" ) & "k over budget.",
			            "All banks are within their fee budget."
			        )
		displayFolder: 4 Budget vs actual
		lineageTag: 7497dffa-eca9-4b58-b9b7-a87d2389daa4

	measure 'Fees CHF' = SUM ( FactBankFees[Amount_CHF] )
		formatString: #,0
		displayFolder: 5 Bank fees and service
		lineageTag: 90087ccc-dbff-4e41-9b55-918fd1053c8d

	measure 'Fees PY CHF' = CALCULATE ( [Fees CHF], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
		formatString: #,0
		displayFolder: 5 Bank fees and service
		lineageTag: 9c67c722-dc40-43c5-8e4a-385d107dac89

	measure 'Fees YoY %' = DIVIDE ( [Fees CHF] - [Fees PY CHF], [Fees PY CHF] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 5 Bank fees and service
		lineageTag: 2ff4b1e7-d3d2-4205-9ab2-6a1fc3d99c02

	measure 'Fees YTD CHF' =
			VAR _End = MIN ( MAX ( 'Date'[Date] ), [Last Fee Date] )
			RETURN CALCULATE ( [Fees CHF], DATESBETWEEN ( 'Date'[Date], DATE ( YEAR ( _End ), 1, 1 ), _End ) )
		formatString: #,0.00
		displayFolder: 5 Bank fees and service
		lineageTag: 4809740b-d6c6-4a8e-ae83-c9bcc6c2878a

	measure 'Fees YTD PY CHF' =
			VAR _End = MIN ( MAX ( 'Date'[Date] ), [Last Fee Date] )
			RETURN CALCULATE ( [Fees CHF], DATESBETWEEN ( 'Date'[Date], DATE ( YEAR ( _End ) - 1, 1, 1 ), EDATE ( _End, -12 ) ) )
		formatString: #,0.00
		displayFolder: 5 Bank fees and service
		lineageTag: b52a808c-cab2-4266-b63e-c630ccfbfc80

	measure 'Fees YTD YoY %' = DIVIDE ( [Fees YTD CHF] - [Fees YTD PY CHF], [Fees YTD PY CHF] )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 5 Bank fees and service
		lineageTag: 66640400-b1cb-4900-bfea-164075e37a75

	measure 'Fees Rolling 3M CHF' = CALCULATE ( [Fees CHF], DATESINPERIOD ( 'Date'[Date], MAX ( 'Date'[Date] ), -3, MONTH ) )
		formatString: #,0
		displayFolder: 5 Bank fees and service
		lineageTag: 3e89e143-d4d7-4f60-bfb3-bacbafb28329

	/// Rolling 3 months against the same 3 months a year earlier. Smooths out
	/// monthly noise, so only lasting changes such as a new tariff show up.
	/// Blank until a full prior-year window exists and after the last fee month.
	measure 'Fees Rolling 3M YoY %' =
			VAR _End = MAX ( 'Date'[Date] )
			VAR _First = CALCULATE ( MIN ( FactBankFees[FeeMonth] ), REMOVEFILTERS () )
			VAR _Now = [Fees Rolling 3M CHF]
			VAR _PY = CALCULATE ( [Fees Rolling 3M CHF], SAMEPERIODLASTYEAR ( 'Date'[Date] ) )
			RETURN
			    IF (
			        EOMONTH ( _End, -15 ) + 1 >= _First && _End <= [Last Fee Date] && _PY > 0,
			        DIVIDE ( _Now, _PY ) - 1
			    )
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 5 Bank fees and service
		lineageTag: 7f8aacf3-4c4c-44eb-9d22-e56dc54bbd90

	/// Fee value on months where the rolling 3-month change exceeds 15%. Used as a marker series.
	measure 'Fee Step Change' = IF ( ABS ( [Fees Rolling 3M YoY %] ) > 0.15, [Fees CHF] )
		formatString: #,0
		displayFolder: 5 Bank fees and service
		lineageTag: a41ea8c4-5613-4656-b058-6c07cc193da1

	measure 'Fees vs Budget YTD %' =
			VAR _A = CALCULATE ( [Actual YTD CHF], FactTreasuryPnL[Line] = "Bank fees" )
			VAR _B = CALCULATE ( [Budget YTD CHF], FactTreasuryPnL[Line] = "Bank fees" )
			RETURN DIVIDE ( _A, _B ) - 1
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 5 Bank fees and service
		lineageTag: e56c4120-9ea3-47e7-b653-070bcca6f5a7

