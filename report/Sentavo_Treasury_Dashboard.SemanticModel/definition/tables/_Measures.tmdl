	measure 'Deposits Placed CHF' = SUM ( FactTermDeposits[Principal_CHF] )
		formatString: #,0
		displayFolder: 6 Deposits and MMFs
		lineageTag: 7a4c59b5-34fc-47f4-8bd1-de8688168e94

	/// Deposits by maturity date: the inactive relationship on MaturityDate is switched on.
	measure 'Deposits Maturing CHF' = CALCULATE ( [Deposits Placed CHF], USERELATIONSHIP ( FactTermDeposits[MaturityDate], 'Date'[Date] ) )
		formatString: #,0
		displayFolder: 6 Deposits and MMFs
		lineageTag: f78a4c4e-da59-4a88-987d-167be90ead38

	/// Maturity ladder: deposits still outstanding at the as-of date, by maturity month.
	measure 'Maturity Ladder CHF' = CALCULATE ( [Deposits Maturing CHF], FactTermDeposits[Status] = "Outstanding" )
		formatString: #,0
		displayFolder: 6 Deposits and MMFs
		lineageTag: b1e00dc5-5333-42d8-9d75-97cac6ca6d13

	measure 'Term Deposits CHF' = CALCULATE ( [Cash CHF], FactLiquidityPosition[Instrument] = "Term deposit" )
		formatString: #,0.0
		displayFolder: 6 Deposits and MMFs
		lineageTag: ebd5a764-0714-4c11-92c9-ac03fd27405e

	measure 'Placed Rate %' =
			DIVIDE (
			    SUMX ( FactTermDeposits, FactTermDeposits[Principal_CHF] * FactTermDeposits[InterestRate_pct] ),
			    SUM ( FactTermDeposits[Principal_CHF] )
			) / 100
		formatString: 0.00%
		displayFolder: 6 Deposits and MMFs
		lineageTag: aeb5924b-a108-462b-8b8d-6a79d33719f8

	measure 'Quoted Rate %' = AVERAGE ( FactDepositQuotes[QuotedRate_pct] ) / 100
		formatString: 0.00%
		displayFolder: 6 Deposits and MMFs
		lineageTag: aac66232-07dc-42fa-adfd-d29c5f5fec95

	measure 'Benchmark Rate %' = AVERAGE ( MarketBenchmarkRates[Rate_pct] ) / 100
		formatString: 0.00%
		displayFolder: 6 Deposits and MMFs
		lineageTag: ee1fca75-bfb6-4cbe-b077-0cc2773ec8a4

	/// Placed rate against the best quote for the same month, currency and tenor,
	/// weighted by principal. Negative = placed below the best available quote.
	measure 'Placed vs Best Quote bps' =
			VAR _Rows =
			    ADDCOLUMNS (
			        FactTermDeposits,
			        "@Best",
			            VAR _M = DATE ( YEAR ( FactTermDeposits[StartDate] ), MONTH ( FactTermDeposits[StartDate] ), 1 )
			            VAR _C = FactTermDeposits[Currency]
			            VAR _T = FactTermDeposits[Tenor]
			            RETURN
			                CALCULATE (
			                    MAX ( FactDepositQuotes[QuotedRate_pct] ),
			                    REMOVEFILTERS (),
			                    FactDepositQuotes[QuoteMonth] = _M,
			                    FactDepositQuotes[Currency] = _C,
			                    FactDepositQuotes[Tenor] = _T
			                )
			    )
			RETURN
			    DIVIDE (
			        SUMX ( _Rows, FactTermDeposits[Principal_CHF] * ( FactTermDeposits[InterestRate_pct] - [@Best] ) ),
			        SUMX ( _Rows, FactTermDeposits[Principal_CHF] )
			    ) * 100
		formatString: +0.0;-0.0;0.0
		displayFolder: 6 Deposits and MMFs
		lineageTag: b5de6620-3c36-4d94-9e1f-7d3c61a74d91

	/// Placed rate against the benchmark (SARON, €STR, SOFR) on the start date, weighted by principal.
	measure 'Placed vs Benchmark bps' =
			VAR _Rows =
			    ADDCOLUMNS (
			        FactTermDeposits,
			        "@Bench",
			            VAR _D = FactTermDeposits[StartDate]
			            VAR _C = FactTermDeposits[Currency]
			            RETURN
			                CALCULATE (
			                    MAX ( MarketBenchmarkRates[Rate_pct] ),
			                    REMOVEFILTERS (),
			                    MarketBenchmarkRates[Date] = _D,
			                    MarketBenchmarkRates[Currency] = _C
			                )
			    )
			RETURN
			    DIVIDE (
			        SUMX ( _Rows, FactTermDeposits[Principal_CHF] * ( FactTermDeposits[InterestRate_pct] - [@Bench] ) ),
			        SUMX ( _Rows, FactTermDeposits[Principal_CHF] )
			    ) * 100
		formatString: +0.0;-0.0;0.0
		displayFolder: 6 Deposits and MMFs
		lineageTag: 5a5db64b-2ae6-4acc-b3b0-18e208ba529a

	measure 'MMF Holdings CHF' = CALCULATE ( [Cash CHF], FactLiquidityPosition[CounterpartyType] = "Fund" )
		formatString: #,0.0
		displayFolder: 6 Deposits and MMFs
		lineageTag: 9ee3505e-fdeb-407c-90e7-d4cf7f07d8f4

	measure 'MMF Yield %' = AVERAGE ( FactMMFYield[Yield7d_pct] ) / 100
		formatString: 0.00%
		displayFolder: 6 Deposits and MMFs
		lineageTag: 4234c53b-b955-459a-a483-d22027256646

	/// Fund yield minus the benchmark of the fund's currency, averaged over funds.
	measure 'MMF Excess Yield bps' =
			AVERAGEX (
			    VALUES ( DimFund[FundKey] ),
			    VAR _Ccy = CALCULATE ( SELECTEDVALUE ( DimFund[Currency] ) )
			    VAR _Fund = CALCULATE ( AVERAGE ( FactMMFYield[Yield7d_pct] ) )
			    VAR _Bench = CALCULATE ( AVERAGE ( MarketBenchmarkRates[Rate_pct] ), REMOVEFILTERS ( DimCurrency ), MarketBenchmarkRates[Currency] = _Ccy )
			    RETURN ( _Fund - _Bench ) * 100
			)
		formatString: +0.0;-0.0;0.0
		displayFolder: 6 Deposits and MMFs
		lineageTag: 878ae293-1378-438f-8879-4178b866018d

	/// Share of MMF holdings in the largest fund.
	measure 'MMF Largest Fund %' = DIVIDE ( MAXX ( VALUES ( DimFund[FundKey] ), [MMF Holdings CHF] ), [MMF Holdings CHF] )
		formatString: 0.0%
		displayFolder: 6 Deposits and MMFs
		lineageTag: 6d6836dd-9e0d-40f1-8bb2-3d02a64293dc

	measure 'DQ Checks Passed' = CALCULATE ( COUNTROWS ( 'Data Quality Checks' ), 'Data Quality Checks'[Failures] = 0 ) + 0
		formatString: 0
		displayFolder: 7 Data quality
		lineageTag: 34c5dba3-6254-4e51-800a-b8b84ffb15bd

	measure 'DQ Checks Total' = COUNTROWS ( 'Data Quality Checks' )
		formatString: 0
		displayFolder: 7 Data quality
		lineageTag: d1d434c6-fdca-4e95-a5d8-feffe8cc4c95

	measure 'DQ Status' = IF ( [DQ Checks Passed] = [DQ Checks Total], "All checks pass", FORMAT ( [DQ Checks Total] - [DQ Checks Passed], "0" ) & " check(s) failing" )
		displayFolder: 7 Data quality
		lineageTag: d0fd95fd-0d4a-4f14-b1cd-1072c4ece641

	measure 'Reconciled Figures' = CALCULATE ( COUNTROWS ( Reconciliation ), Reconciliation[Status] = "Match" ) & " of " & COUNTROWS ( Reconciliation )
		displayFolder: 7 Data quality
		lineageTag: dca5e395-84b4-422e-8e04-1460b6c2b7b1

	measure 'Last Load Date' = MAX ( FactLiquidityPosition[Date] )
		formatString: d mmm yyyy
		displayFolder: 7 Data quality
		lineageTag: b4a09193-126e-4dfe-ab6b-57409cb3c795

	measure 'Current User' = USERPRINCIPALNAME ()
		displayFolder: 8 Security
		lineageTag: 31fed5b5-89f9-4f32-8bc4-571d53e2e775

	/// Last day of the last month with booked actuals.
	measure 'Last Actual Date' = EOMONTH ( [Last Actual Month], 0 )
		formatString: d mmm yyyy
		displayFolder: 4 Budget vs actual
		lineageTag: 440c89fe-9822-44bd-93ac-e61c857ab166

	/// End of the year-to-date window: the end of the period in context, but never
	/// later than the last closed month. With no date filter that is the last close.
	measure 'YTD End Date' = MIN ( MAX ( 'Date'[Date] ), [Last Actual Date] )
		formatString: d mmm yyyy
		displayFolder: 4 Budget vs actual
		lineageTag: 748a3804-d810-4df7-adae-42bd9ddd3254

	/// Last day of the last month with bank fee data.
	measure 'Last Fee Date' = EOMONTH ( CALCULATE ( MAX ( FactBankFees[FeeMonth] ), REMOVEFILTERS () ), 0 )
		formatString: d mmm yyyy
		displayFolder: 5 Bank fees and service
		lineageTag: c01300bd-f6de-4c3b-9b21-6145b90face1

	measure 'Fact Rows Loaded' =
			COUNTROWS ( FactLiquidityPosition ) + COUNTROWS ( FactTermDeposits ) + COUNTROWS ( FactMMFYield )
			    + COUNTROWS ( FactDepositQuotes ) + COUNTROWS ( FactFXDeals ) + COUNTROWS ( FactBankFees )
			    + COUNTROWS ( FactBankIssues ) + COUNTROWS ( FactCreditSpreads ) + COUNTROWS ( FactCashForecast )
			    + COUNTROWS ( FactTreasuryPnL )
		formatString: #,0
		displayFolder: 7 Data quality
		lineageTag: 91aa905e-a05d-4bb5-9a2f-e07941ad9df6

	/// Commentary line 1: result against budget for the year to date.
	measure 'Commentary Result' =
			VAR _End = [YTD End Date]
			VAR _A = [Actual YTD CHF]
			VAR _B = [Budget YTD CHF]
			VAR _V = _A - _B
			RETURN
			    "Jan to " & FORMAT ( _End, "mmm yyyy" ) & ": result CHF " & FORMAT ( _A / 1e6, "0.00" )
			        & "m vs budget CHF " & FORMAT ( _B / 1e6, "0.00" ) & "m, "
			        & IF ( _V >= 0, "favourable", "unfavourable" ) & " by CHF " & FORMAT ( ABS ( _V ) / 1e6, "0.00" ) & "m ("
			        & FORMAT ( DIVIDE ( _V, ABS ( _B ) ), "+0.0%;-0.0%" ) & ")."
		displayFolder: 4 Budget vs actual\Commentary
		lineageTag: 96647a16-54ab-4105-9149-e1b7cc2cfc62

	/// Commentary line 2: the P&L line with the largest variance.
	measure 'Commentary Driver' =
			VAR _Lines =
			    ADDCOLUMNS (
			        CALCULATETABLE ( VALUES ( FactTreasuryPnL[Line] ), REMOVEFILTERS ( FactTreasuryPnL[Line] ) ),
			        "@Var", CALCULATE ( [Variance YTD CHF] )
			    )
			VAR _Top = TOPN ( 1, _Lines, ABS ( [@Var] ), DESC )
			RETURN
			    "Largest driver: " & LOWER ( MAXX ( _Top, FactTreasuryPnL[Line] ) ) & " at CHF "
			        & FORMAT ( MAXX ( _Top, [@Var] ) / 1e6, "+0.00;-0.00" ) & "m."
		displayFolder: 4 Budget vs actual\Commentary
		lineageTag: 124bb0ee-e0f8-49c4-a79e-811c5f19a39a

	/// Commentary line 3: the bank most over its fee budget.
	measure 'Commentary Fees' =
			VAR _Banks =
			    ADDCOLUMNS (
			        VALUES ( DimBank[BankLabel] ),
			        "@FeeVar", CALCULATE ( [Variance YTD CHF], FactTreasuryPnL[Line] = "Bank fees" )
			    )
			VAR _Worst = TOPN ( 1, _Banks, [@FeeVar], ASC )
			VAR _Var = MAXX ( _Worst, [@FeeVar] )
			RETURN
			    IF (
			        _Var < 0,
			        "Bank fees: " & MAXX ( _Worst, DimBank[BankLabel] ) & " is CHF " & FORMAT ( ABS ( _Var ) / 1e3, "0" ) & "k over budget.",
			        "Bank fees: every bank is within budget."
			    )
		displayFolder: 4 Budget vs actual\Commentary
		lineageTag: 2e64bea0-212b-47c7-b275-75ea4c624df3

	/// One commentary sentence per row of Commentary Lines.
	measure 'Commentary Text' =
			SWITCH (
			    SELECTEDVALUE ( 'Commentary Lines'[No] ),
			    1, [Commentary Result],
			    2, [Commentary Driver],
			    3, [Commentary Fees]
			)
		displayFolder: 4 Budget vs actual\Commentary
		lineageTag: 2f4bddf1-276f-4aee-ab47-8810f5e85d03

	/// Short name of the latest reforecast for a card, e.g. "Q2".
	measure 'Latest Forecast Label' = SUBSTITUTE ( [Latest Forecast], "Forecast ", "" )
		displayFolder: 4 Budget vs actual
		lineageTag: bc7bd97b-d630-4bfc-893e-fd17c2d394d6

	/// Last closed month for a card, e.g. "Sep 2026".
	measure 'Actuals To' = FORMAT ( [Last Actual Date], "mmm yyyy" )
		displayFolder: 4 Budget vs actual
		lineageTag: 067d694e-a77d-4991-a55e-ebd9a53bd7a4

	measure 'FX Volume CHF' = SUM ( FactFXDeals[Notional_CHF] )
		formatString: #,0.0
		displayFolder: 9 FX execution
		lineageTag: bdbf8578-2cbc-4d5c-b619-8fe3d1b35f61

	measure 'FX Deals' = COUNTROWS ( FactFXDeals )
		formatString: #,0
		displayFolder: 9 FX execution
		lineageTag: 9933090a-9133-46dc-9783-8afbdafe8a43

	/// Bid-ask spread weighted by CHF notional.
	measure 'FX Spread bps' = DIVIDE ( SUMX ( FactFXDeals, FactFXDeals[Notional_CHF] * FactFXDeals[Spread_bps] ), SUM ( FactFXDeals[Notional_CHF] ) )
		formatString: 0.00
		displayFolder: 9 FX execution
		lineageTag: 100214ac-ebbe-406c-a6d0-3d397b657e82

	/// Half the spread on each deal, the same basis as FX cost in the treasury P&L.
	measure 'FX Cost CHF' = SUMX ( FactFXDeals, FactFXDeals[Notional_CHF] * FactFXDeals[Spread_bps] / 2 / 10000 )
		formatString: #,0
		displayFolder: 9 FX execution
		lineageTag: b2602f19-017a-4131-904a-0f01bbad509a

	measure 'FX Platform Share %' = DIVIDE ( CALCULATE ( [FX Volume CHF], FactFXDeals[ExecutionChannel] = "Multi-bank platform" ), [FX Volume CHF] )
		formatString: 0.0%
		displayFolder: 9 FX execution
		lineageTag: 11da001e-e31d-4775-8511-207220837413

	measure 'FX Share of Wallet %' = DIVIDE ( [FX Volume CHF], CALCULATE ( [FX Volume CHF], REMOVEFILTERS ( DimBank ) ) )
		formatString: 0.0%
		displayFolder: 9 FX execution
		lineageTag: 8c6492cc-742f-4ab1-a27b-a9a85c545a86

	/// Forecast error of the 13-week-ahead forecast, per week or period in context.
	measure 'WAPE 13W %' = CALCULATE ( [Forecast WAPE %], FactCashForecast[HorizonWeeks] = 13 )
		formatString: 0.0%
		displayFolder: 3 Forecast
		lineageTag: 2efeb8e4-086d-45a7-bc8a-53eff22ae313

	measure 'WAPE 1W %' = CALCULATE ( [Forecast WAPE %], FactCashForecast[HorizonWeeks] = 1 )
		formatString: 0.0%
		displayFolder: 3 Forecast
		lineageTag: e1f17df8-5efa-45bb-ae76-bae3eff804a3

	measure 'Selected Bank' = SELECTEDVALUE ( DimBank[BankLabel], "All banks" )
		displayFolder: 2 Counterparty risk\Tooltip
		lineageTag: e7def0e5-9c6b-489e-947d-a134fd69a7fa

	measure 'Bank Rating Outlook' = SELECTEDVALUE ( DimBank[Rating] ) & ", " & LOWER ( SELECTEDVALUE ( DimBank[Outlook] ) ) & " outlook"
		displayFolder: 2 Counterparty risk\Tooltip
		lineageTag: 2480e60f-cbe4-4032-9fb0-a7c8df7c07be

	/// Business days over the limit across the whole period, whatever date is in context.
	measure 'Days Over Limit Total' = CALCULATE ( [Days Over Limit], REMOVEFILTERS ( 'Date' ) ) + 0
		formatString: 0
		displayFolder: 2 Counterparty risk\Tooltip
		lineageTag: ca31e49b-a2e0-411f-a0ef-556007e575e7

	measure 'Tooltip Date' = FORMAT ( MAX ( FactLiquidityPosition[Date] ), "d mmm yyyy" )
		displayFolder: 2 Counterparty risk\Tooltip
		lineageTag: 13afe04a-98f2-4a7a-8eee-5ed0079fa191

	/// FX volume in CHF millions, for tables.
	measure 'FX Volume CHF m' = DIVIDE ( [FX Volume CHF], 1e6 )
		formatString: #,0.0
		displayFolder: 9 FX execution
		lineageTag: d5dbf672-92de-432d-9fc7-550a8b341ca3

	/// Dynamic title for the Bank Detail page.
	measure 'Bank Detail Title' = [Selected Bank] & ": monthly fees (CHF)"
		displayFolder: 2 Counterparty risk\Tooltip
		lineageTag: a9e45660-20c3-4ed1-8555-6cc1f3998939

	column Column1
		dataType: string
		lineageTag: 67a18a03-ae0c-44f8-b9be-a87e084aea8d
		summarizeBy: none
		sourceColumn: Column1

		annotation SummarizationSetBy = Automatic

	partition _Measures = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}})
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table

