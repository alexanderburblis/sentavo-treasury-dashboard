	/// Principal in CHF at the FX rate of the start date.
	column Principal_CHF =
			FactTermDeposits[Principal_LC]
			    * LOOKUPVALUE (
			        MarketFXRates[CHF_per_unit],
			        MarketFXRates[Date], FactTermDeposits[StartDate],
			        MarketFXRates[CurrencyCode], FactTermDeposits[Currency]
			    )
		dataType: double
		formatString: #,0
		lineageTag: d23355ee-6c24-47a9-8e63-4e8a4f0beb2d
		summarizeBy: none

