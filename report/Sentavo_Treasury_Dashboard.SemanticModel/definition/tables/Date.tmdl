	/// 1 for months with booked actuals. Budget and forecast comparisons stop here.
	column IsClosedMonth =
			VAR _Last = MAXX ( FILTER ( FactTreasuryPnL, FactTreasuryPnL[Scenario] = "Actual" ), FactTreasuryPnL[Month] )
			RETURN IF ( 'Date'[Date] <= EOMONTH ( _Last, 0 ), 1, 0 )
		dataType: int64
		formatString: 0
		lineageTag: a3a3793c-a154-4793-ba04-955cfb694443
		summarizeBy: none

	column MonthNo = MONTH ( 'Date'[Date] )
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: e72443a3-74d7-48c0-962b-6afd9cf3a63d
		summarizeBy: none

	column MonthShort = FORMAT ( 'Date'[Date], "MMM" )
		dataType: string
		lineageTag: 78731b15-4649-420f-a3ea-3aca52f08c67
		summarizeBy: none
		sortByColumn: MonthNo

	partition Date = calculated
		mode: import
		source = ADDCOLUMNS ( CALENDAR ( DATE ( 2024, 1, 1 ), DATE ( 2027, 12, 31 ) ), "Year", YEAR ( [Date] ), "MonthStart", DATE ( YEAR ( [Date] ), MONTH ( [Date] ), 1 ), "Month", FORMAT ( [Date], "MMM yyyy" ), "Quarter", "Q" & QUARTER ( [Date] ) & " " & YEAR ( [Date] ), "WeekStart", [Date] - WEEKDAY ( [Date], 2 ) + 1, "IsWeekday", WEEKDAY ( [Date], 2 ) <= 5)

	annotation PBI_Id = b9502699fdc44e9397eed0e47f2fe6eb

